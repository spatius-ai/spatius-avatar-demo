VITE_SPATIUS_APP_ID= # https://app.spatius.ai/apps
VITE_SPATIUS_AVATAR_ID=aed008e4-8ddf-41aa-b5b2-5d7321dd4165 # https://app.spatius.ai/avatars/library
VITE_SPATIUS_SESSION_TOKEN= # https://docs.spatius.ai/api-reference/api-reference#obtain-a-session-token

# The default UI mode sends bundled sample audio and only needs the Spatius values above.
# Realtime conversation is optional; fill one provider section below only when you select
# Realtime conversation in the browser UI.

# For local development only. Prefer a browser-safe ephemeral token.
# Do not expose a long-lived provider API key in a production browser app.
# Choose: openai or gemini.
VITE_REALTIME_PROVIDER=openai
VITE_REALTIME_INSTRUCTIONS=You are a concise, friendly avatar assistant. Keep replies short enough for a realtime demo.

# OpenAI Realtime WebSocket adapter.
# Docs: https://developers.openai.com/api/docs/guides/realtime-websocket
VITE_OPENAI_REALTIME_TOKEN=
VITE_OPENAI_REALTIME_MODEL=gpt-realtime
VITE_OPENAI_REALTIME_VOICE=marin

# Gemini Live raw WebSocket adapter.
# Input audio is PCM16 mono 16 kHz; output audio is PCM16 mono 24 kHz.
# Docs: https://ai.google.dev/gemini-api/docs/live-api
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
VITE_GEMINI_API_VERSION=v1alpha
